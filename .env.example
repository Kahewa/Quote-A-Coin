# Injected by Google AI Studio. Not read by application code today.
GEMINI_API_KEY=

# Injected by Google AI Studio with the Cloud Run service URL.
APP_URL=

# Set to "true" to disable Vite hot reload inside the AI Studio preview.
DISABLE_HMR=

# --- Firebase -----------------------------------------------------------
# Optional. When set, these override the values in firebase-applet-config.json.
# The Firebase web config is public by design; access control lives in
# firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=
