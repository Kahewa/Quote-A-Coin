# Demo mode: talk to the local Firebase Emulator Suite instead of Google's
# servers. No cloud project, no billing, no network. Loaded by `npm run demo`
# (Vite picks this up via --mode demo). Safe to commit — it points at nothing.
VITE_USE_EMULATORS=true
VITE_FIREBASE_PROJECT_ID=demo-quote-a-coin
VITE_FIREBASE_DATABASE_ID=quote-a-coin

# The emulators ignore these, but the SDK insists on non-empty strings.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-quote-a-coin.firebaseapp.com
VITE_FIREBASE_APP_ID=1:0:web:demo
VITE_FIREBASE_MESSAGING_SENDER_ID=0
VITE_FIREBASE_STORAGE_BUCKET=demo-quote-a-coin.appspot.com
